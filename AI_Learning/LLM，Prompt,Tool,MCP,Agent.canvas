	"nodes":[
		{"id":"986e0613bd610c6f","type":"text","text":"Prompt","x":-580,"y":1480,"width":121,"height":60,"color":"1"},
		{"id":"b2609808c7331299","type":"text","text":"Context","x":-590,"y":1165,"width":131,"height":60,"color":"1"},
		{"id":"a26a731d6fe3e5bc","type":"text","text":"就是临时记忆体：里面有上一段对话的东西，还有技能","x":-310,"y":1195,"width":250,"height":60},
		{"id":"5b3c1db018f2edb4","type":"file","file":"Pasted image 20260701143242.png","x":75,"y":1040,"width":400,"height":155},
		{"id":"50b52fe7cec0eccf","type":"text","text":"上下文窗口：Context Windows\n大模型所能容纳的最多部分","x":75,"y":1198,"width":299,"height":80},
		{"id":"72f66a9923cceb55","type":"text","text":" 一个实例：比如一个用户看一个手册，但不可能将所有都直接给大模型去理解，所以我们可以采用","x":75,"y":1278,"width":400,"height":54},
		{"id":"6458e47875225056","type":"text","text":"User Prompt\n就是对话里的","x":-290,"y":1410,"width":160,"height":100},
		{"id":"0a09f017a7fbda4f","type":"text","text":"System Prompt\n在系统背景里做出设定","x":-290,"y":1540,"width":180,"height":80},
		{"id":"b2dceb0e396f39ec","type":"text","text":"运作流程","x":-406,"y":510,"width":116,"height":60,"color":"2"},
		{"id":"d3b63013fc781bc7","type":"text","text":"解码","x":126,"y":510,"width":82,"height":60},
		{"id":"62c0999dcedd0f12","type":"text","text":"用户","x":-156,"y":540,"width":90,"height":60},
		{"id":"8bfb5a47fead404d","type":"text","text":"大模型","x":379,"y":540,"width":96,"height":60},
		{"id":"aefabb3928a374fc","type":"text","text":"编码","x":126,"y":570,"width":82,"height":60},
		{"id":"e8e13a7e9a2c2f44","type":"text","text":"Token\n","x":-630,"y":630,"width":100,"height":60,"color":"1"},
		{"id":"04b21c887d7b6354","type":"text","text":"0.75个英文单词","x":-126,"y":685,"width":176,"height":60},
		{"id":"7441dfb8b6fe18f4","type":"text","text":"就 是大模型自己把一段话切分为他能够理解的最小词元","x":-465,"y":740,"width":250,"height":60,"color":"2"},
		{"id":"8667ccb56dad4f48","type":"text","text":"1.5~2个汉字","x":-126,"y":800,"width":144,"height":60},
		{"id":"b47d3704285e57c1","type":"text","text":"切分（把每一个词语切分为最小单元——词元，每一个词元就是一个token）","x":-156,"y":320,"width":250,"height":80},
		{"id":"b5d9b264c0b43476","type":"text","text":"映射（把词元拆出来后给出对应的数字）","x":228,"y":330,"width":199,"height":60},
		{"id":"c2aaa6c2d28221db","type":"text","text":"白话去理解就是，你输入一个，他会把前几个词语输入，再有概率的给出下一个 词","x":60,"y":-296,"width":250,"height":112},
		{"id":"a5bb3d64bad65802","type":"text","text":"LLM","x":-680,"y":-270,"width":100,"height":60,"color":"1"},
		{"id":"ae60544d001ed4b2","type":"file","file":"Pasted image 20260701132611.png","x":-400,"y":-440,"width":249,"height":400},
		{"id":"db8ab3846dc9c684","type":"text","text":"就是相当于一个函数：你有输入他就有输出","x":1685,"y":415,"width":250,"height":60},
		{"id":"b3469eb6b2562130","type":"text","text":"Tool","x":1440,"y":475,"width":93,"height":60,"color":"1"},
		{"id":"5ac89fe4656f8bef","type":"text","text":"用户","x":2000,"y":535,"width":78,"height":60},
		{"id":"5f1ff29f848f1aa8","type":"text","text":"实例","x":1765,"y":795,"width":50,"height":60},
		{"id":"6bef63e84855ad85","type":"text","text":"平台","x":2340,"y":535,"width":80,"height":60},
		{"id":"98880fff2bdb8703","type":"text","text":"大模型","x":2620,"y":535,"width":111,"height":60},
		{"id":"43074fe655cab739","type":"text","text":"平台","x":2340,"y":695,"width":80,"height":60},
		{"id":"0baaf81fd01d85c3","type":"text","text":"大模型","x":2620,"y":695,"width":111,"height":60},
		{"id":"80b7d34bd07a82ee","type":"text","text":"大模型的作用：1.告诉平台用什么工具；2.将最后的结果总结归纳呈现给用户","x":2791,"y":390,"width":266,"height":85,"color":"6"},
		{"id":"1d93c0dbf7e03481","type":"text","text":"平台：串联流程；调用工具","x":2791,"y":475,"width":250,"height":60,"color":"6"},
		{"id":"3d9c16641f0e7034","type":"file","file":"Pasted image 20260703211724.png","x":3057,"y":390,"width":400,"height":265},
		{"id":"e472ef67536cb8ec","type":"text","text":"平台","x":2340,"y":855,"width":80,"height":60},
		{"id":"565d35c6071227f6","type":"text","text":"工具","x":3011,"y":855,"width":91,"height":60},
		{"id":"c79705e633304414","type":"text","text":"平台","x":2340,"y":1015,"width":80,"height":60},
		{"id":"e4d705c236afe698","type":"text","text":"工具","x":3011,"y":1015,"width":82,"height":60},
		{"id":"557304bd08956e50","type":"text","text":"平台","x":2160,"y":1195,"width":80,"height":60},
		{"id":"b6a199d9c76d3481","type":"text","text":"大模型","x":2340,"y":1195,"width":80,"height":60},
		{"id":"7575bacaafa296f8","type":"text","text":"用户","x":2000,"y":1195,"width":84,"height":60},
		{"id":"838898c852d4e0d5","type":"text","text":"在上述的Tool中，主要是模型告诉平台要调用什么工具，所以说是，tool全部在平台上，至于工具怎么接入平台，可是就有很多讲究了，OpenAl，Google,Anthropic都有自己的把工具接入平台的方法","x":1520,"y":1620,"width":277,"height":196,"color":"6"},
		{"id":"762bdd58218187b8","type":"text","text":"MCP","x":1280,"y":1896,"width":85,"height":60,"color":"1"},
		{"id":"ff46bf2edff2b929","type":"text","text":"平台","x":1568,"y":1896,"width":91,"height":60},
		{"id":"e2296abef80b8ac9","type":"text","text":"工具","x":1739,"y":1896,"width":80,"height":60},
		{"id":"f10f179236caacd7","type":"text","text":"Model Context Protool（模型上下文协议），就是协调平台接入工具的规范，只要按照MCP开发工具，所有平台就可按照这样接入工具","x":1568,"y":2080,"width":323,"height":120},
		{"id":"dabd7fe2c6b0c925","type":"text","text":"自行进行分系，自行调用相关工具，然后去解决问题","x":76,"y":2020,"width":250,"height":60},
		{"id":"f6ffda1883d315a0","type":"text","text":"name:\ndescription:\n\n#目标\n#执行步骤\n#判断规则\n#输出格式\n#示例\n###用户问题\n###天气工具\n###最终输出\n","x":441,"y":2020,"width":140,"height":292},
		{"id":"5dbe65405fde6aac","type":"text","text":"Agent Skill","x":65,"y":2158,"width":136,"height":60,"color":"2"},
		{"id":"cb1f66dd0defe8f7","type":"text","text":"1.需要在这个目录下新建文件夹，这个文件夹的名字必须和你的skill的名字一致\n2.在这个文件夹里存储的skill，必须命名为SKILL.md","x":681,"y":2381,"width":250,"height":209},
		{"id":"d1900d8d9f80ac65","type":"text","text":"存储：比如claude code 就需要找到.claude/skills","x":302,"y":2424,"width":250,"height":60},
		{"id":"b5dab0e880b858cd","type":"text","text":"Agent","x":-275,"y":2166,"width":94,"height":60,"color":"1"},
		{"id":"fde7b00ad90be73d","type":"text","text":"详细的MCP步骤，我自己开发\n","x":1234,"y":2347,"width":266,"height":60,"color":"2"},
